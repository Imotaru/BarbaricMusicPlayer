<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyTitle>Barbaric Music Player</AssemblyTitle>
    <UiDir>$(MSBuildThisFileDirectory)..\..\ui\</UiDir>
    <UiDistDir>$(UiDir)dist\</UiDistDir>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Barbaric.Core\Barbaric.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
  </ItemGroup>

  <!-- Release builds bundle a fresh production build of the web UI. -->
  <Target Name="BuildUi" BeforeTargets="BeforeBuild" Condition="'$(Configuration)' == 'Release'">
    <Exec Command="npm install" WorkingDirectory="$(UiDir)" Condition="!Exists('$(UiDir)node_modules')" />
    <Exec Command="npm run build" WorkingDirectory="$(UiDir)" />
  </Target>

  <!-- Copies the built UI (if any) next to the exe; Debug builds fall back to it when the dev server is not running. -->
  <Target Name="CopyUi" AfterTargets="Build" Condition="Exists('$(UiDistDir)index.html')">
    <ItemGroup>
      <UiFile Include="$(UiDistDir)**\*" />
    </ItemGroup>
    <RemoveDir Directories="$(OutDir)wwwroot" />
    <Copy SourceFiles="@(UiFile)" DestinationFiles="@(UiFile->'$(OutDir)wwwroot\%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>

  <Target Name="PublishUi" AfterTargets="Publish" Condition="Exists('$(UiDistDir)index.html')">
    <ItemGroup>
      <UiPublishFile Include="$(UiDistDir)**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(UiPublishFile)" DestinationFiles="@(UiPublishFile->'$(PublishDir)wwwroot\%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>

</Project>
